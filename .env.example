# Docker Compose configuration (replaced dynamically by setup.ps1)
COMPOSE_PROJECT_NAME=${PROJECT_NAME}-parakeet-asr
FRONTEND_NETWORK=${FRONTEND_NETWORK}
PROXY_NETWORK=${PROXY_NETWORK}

# Model configuration
# Change these and rebuild with --no-cache to use different models
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
SILERO_VAD_REPO=snakers4/silero-vad

# Audio processing
TARGET_SAMPLE_RATE=16000

# Performance settings
MODEL_PRECISION=fp16
DEVICE=cuda
BATCH_SIZE=4
MAX_AUDIO_DURATION=30
VAD_THRESHOLD=0.5
PROCESSING_TIMEOUT=60

# Backend selection: "nemo" (default) or "onnx"
# ONNX backend requires: pip install onnx-asr onnxruntime-gpu
MODEL_BACKEND=nemo
ONNX_MODEL_NAME=base.int8

# Chunking method: "vad" (default, Silero VAD) or "silence" (FFmpeg silencedetect)
# "silence" is faster (no PyTorch overhead), good for realtime use cases
CHUNKING_METHOD=vad
SILENCE_THRESHOLD=-30dB
SILENCE_DURATION=0.5

# Logging
LOG_LEVEL=INFO
